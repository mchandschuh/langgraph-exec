{
  "name": "langgraph-exec",
  "version": "0.3.0",
  "description": "YAML-defined, composable LangGraph execution CLI and library.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "bin": {
    "langgraph-exec": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "SKILL.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc",
    "start": "node ./bin/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.7.3",
    "llm": "file:../llm",
    "yaml": "^2.7.0",
    "zod": "^4.2.0"
  }
}
